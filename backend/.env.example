# Primary DB for deployment / production
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/giri_rakshak

# JWT
JWT_SECRET_KEY=replace-with-a-random-32-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Frontend origins, comma separated
CORS_ORIGINS=http://localhost:5500,http://localhost:5173,https://your-frontend.vercel.app

# Uploads
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads/reports

# Optional sensor protection. Keep blank for local ESP32 testing, set in deployment.
SENSOR_API_KEY=

# Seed official account (optional; can pass CLI args instead)
SEED_OFFICIAL_EMAIL=official@girirakshak.local
SEED_OFFICIAL_PASSWORD=ChangeThisForDemo
